
# Application
APP_NAME=VaxInsight
APP_ENV=development
DEBUG=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vaccine_ai
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-password
DB_SSL_MODE=prefer

# Test-only database bootstrap. Leave commented for normal API development.
# Pytest defaults to vaccine_ai_test and rejects protected database names.
# VAXINSIGHT_TEST_DB_NAME=vaccine_ai_test
# VAXINSIGHT_POSTGRES_MAINTENANCE_DB=postgres


# Security
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=vaxinsight-api
JWT_AUDIENCE=vaxinsight-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_COMMUNITY_REGISTRATION=true

# Email delivery
# Set this to a hosted browser client, or to the API landing path during local
# development, for example http://<lan-ip>:8000/api/v1/auth.
ACCOUNT_ACTION_BASE_URL=
# Installed builds use the native app scheme. For Expo Go development, use
# exp://<your-computer-lan-ip>:8081/-- instead.
MOBILE_DEEP_LINK_BASE_URL=vaxinsight://
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
INVITATION_RATE_LIMIT=10
RESET_RATE_LIMIT=5
NARRATIVE_RATE_LIMIT=10
QUESTION_RATE_LIMIT=10
RATE_LIMIT_CLEANUP_BATCH_SIZE=500
RATE_LIMIT_CLEANUP_MAX_BATCHES=10

# Optional browser client origins, comma-separated
CORS_ALLOWED_ORIGINS=

# Machine Learning
MODEL_PATH=models/
